# ==============================================================================
# BusSense-AI Environment Configuration
# Copy this file to .env and configure local settings
# ==============================================================================

# Application Settings
APP_NAME=BusSense-AI
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bussense_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bussense_db

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30

# Relative Paths (Resolved dynamically using pathlib)
DATA_DIR=data
OUTPUT_DIR=data/outputs
MODELS_DIR=models
